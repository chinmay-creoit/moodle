# ---------------------------------------------------------------------------
# Environment for docker-compose.yml. Copy to .env for local use; in Dokploy paste these
# into the service's Environment tab. Never commit a real .env.
# Avoid $ # quotes and spaces in passwords (compose/.env parsing).
# ---------------------------------------------------------------------------

# Public URL users type in the browser. Must match exactly, no trailing slash.
# Dokploy: https://lms.yourdomain.com      Local: http://localhost:8080
MOODLE_URL=https://lms.example.com

# Port Apache listens on INSIDE the container.
# Dokploy: leave at 80 (set the Domain's container port to 80).
# Local: use the port from MOODLE_URL (8080) so Moodle can reach its own URL for self-checks.
APACHE_PORT=80

# PostgreSQL 17 (internal only, never published)
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=change-me-db-password

# First-install admin account (only used when the database is empty).
# Moodle's default policy wants 8+ chars with upper, lower, digit and a symbol.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Change-Me-1!
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_FULLNAME=My Moodle
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_LANG=en

# Run admin/cli/upgrade.php on startup so a new image version upgrades the site. (true|false)
MOODLE_AUTO_UPGRADE=true
# Cap on Apache workers (each can hold a DB connection; Postgres allows 200). Size to your RAM.
APACHE_MAX_REQUEST_WORKERS=40

# ---- LOCAL ONLY (do not set in Dokploy) -------------------------------------
# Also load the override that publishes the port on the host.
#COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
